{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ai-app",
  "version": "1.0.0",
  "description": "提供数据分析、结构搭建、记录修改与自由页面生成四项独立技能，共用支持跨 App 的可信原生工具。",
  "keywords": ["apps", "data", "analysis", "pages"],
  "extensions": {
    "com.lesschaos": {
      "interface": {
        "displayName": "AI应用"
      },
      "nativeTools": {
        "app_list": "app.appCatalog.v1",
        "app_definition": "app.appDefinition.v1",
        "app_query": "app.query.v1",
        "app_aggregate": "app.aggregates.v1",
        "app_read_record": "app.modelRead.v1",
        "app_update_record": "app.modelUpdate.v1",
        "app_command": "app.executeCommand.v1",
        "app_create": "app.createApp.v1",
        "app_define": "app.applyDefinition.v1",
        "app_page_list": "app.pageList.v1",
        "app_page_read": "app.pageRead.v1",
        "app_page_save": "app.pageSave.v1",
        "app_page_publish": "app.pagePublish.v1",
        "app_page_remove": "app.pageRemove.v1"
      }
    }
  }
}
